# Database
DB_NAME=oauth2_authorization_server
DB_USERNAME=oauth2
DB_PASSWORD=change-this-password

# Authorization Server
# Local container example:
AUTHORIZATION_SERVER_ISSUER=http://localhost:9000

# Production example:
# AUTHORIZATION_SERVER_ISSUER=https://auth.example.com


# Browser CORS
AUTHORIZATION_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Production:
# AUTHORIZATION_SERVER_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com



# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m



# JVM
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75